    {
      "name": "[Black-box BVA]",
      "item": [
        {
          "name": "[BVA-C] Change newPassword",
          "item": [
            {
              "name": "01 Login bằng mật khẩu gốc",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const caseId = pm.iterationData.get(\"case_id\");\r",
                      "const length = Number(\r",
                      "    pm.iterationData.get(\"target_length\")\r",
                      ");\r",
                      "\r",
                      "const newPassword =\r",
                      "    \"Aa1\" + \"b\".repeat(length - 3);\r",
                      "\r",
                      "pm.environment.set(\"bva_case_id\", caseId);\r",
                      "pm.environment.set(\r",
                      "    \"bva_new_password\",\r",
                      "    newPassword\r",
                      ");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Login with original password succeeds\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "const json = pm.response.json();\r",
                      "const data = json.data || json;\r",
                      "\r",
                      "pm.environment.set(\r",
                      "    \"bva_candidate_token\",\r",
                      "    data.accessToken\r",
                      ");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"{{bva_candidate_email}}\",\r\n  \"password\": \"{{bva_original_password}}\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{api_base_url}}/api/auth/login",
                  "host": [
                    "{{api_base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "02 Đổi sang mật khẩu BVA",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const caseId =\r",
                      "    pm.environment.get(\"bva_case_id\");\r",
                      "\r",
                      "pm.test(`${caseId} boundary password is accepted`, function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bva_candidate_token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "PUT",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"oldPassword\": \"{{bva_original_password}}\",\r\n  \"newPassword\": \"{{bva_new_password}}\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{api_base_url}}/api/users/change-password",
                  "host": [
                    "{{api_base_url}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "change-password"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "03 Đăng nhập bằng mật khẩu BVA",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"BVA password can be used to login\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "const json = pm.response.json();\r",
                      "const data = json.data || json;\r",
                      "\r",
                      "pm.test(\"New access token is returned\", function () {\r",
                      "    pm.expect(data.accessToken).to.exist;\r",
                      "});\r",
                      "\r",
                      "pm.environment.set(\r",
                      "    \"bva_candidate_token\",\r",
                      "    data.accessToken\r",
                      ");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"email\": \"{{bva_candidate_email}}\",\r\n  \"password\": \"{{bva_new_password}}\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{api_base_url}}/api/auth/login",
                  "host": [
                    "{{api_base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "04 Khôi phục mật khẩu ban đầu",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Original password is restored\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "if (pm.response.code === 200) {\r",
                      "    pm.environment.unset(\"bva_new_password\");\r",
                      "    pm.environment.unset(\"bva_candidate_token\");\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{bva_candidate_token}}",
                      "type": "string"
                    }
                  ]
                },
                "method": "PUT",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"oldPassword\": \"{{bva_new_password}}\",\r\n  \"newPassword\": \"{{bva_original_password}}\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{api_base_url}}/api/users/change-password",
                  "host": [
                    "{{api_base_url}}"
                  ],
                  "path": [
                    "api",
                    "users",
                    "change-password"
                  ]
                }
              },
              "response": []
            }
          ]
        },
        {
          "name": "[BVA-A] Register fullName",
          "item": [
            {
              "name": "Run fullName boundaries",
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "const caseId = pm.iterationData.get(\"case_id\");\r",
                      "const length = Number(pm.iterationData.get(\"target_length\"));\r",
                      "\r",
                      "pm.variables.set(\"bva_case_id\", caseId);\r",
                      "pm.variables.set(\"bva_full_name\", \"A\".repeat(length));\r",
                      "pm.variables.set(\r",
                      "    \"bva_email\",\r",
                      "    `bva.name.${Date.now()}.${pm.info.iteration}@example.com`\r",
                      ");"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const caseId = pm.variables.get(\"bva_case_id\");\r",
                      "\r",
                      "pm.test(`${caseId} returns 201`, function () {\r",
                      "    pm.response.to.have.status(201);\r",
                      "});\r",
                      "\r",
                      "pm.test(`${caseId} registration succeeds`, function () {\r",
                      "    pm.expect(pm.response.json().success).to.eql(true);\r",
                      "});"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "auth": {
                  "type": "noauth"
                },
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"fullName\": \"Le\",\r\n  \"email\": \"{{bva_email}}\",\r\n  \"password\": \"Aa1234\",\r\n  \"userRole\": \"CANDIDATE\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{api_base_url}}/api/auth/register",
                  "host": [
                    "{{api_base_url}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "register"
                  ]
                }
              },
              "response": []
            }
          ]
        },
