        {
          "name": "TC_1.1 Register new candidate",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();\r",
                  "const data = json.data || json;\r",
                  "\r",
                  "pm.test(\"TC_1.1 status is 201\", function () {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"TC_1.1 user created\", function () {\r",
                  "  pm.expect(json.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "if (data.user && data.user.email) {\r",
                  "  pm.environment.set(\"new_candidate_email\", data.user.email);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"fullName\": \"Integration Candidate\",\r\n  \"email\": \"candidate{{$timestamp}}@test.com\",\r\n  \"password\": \"Candidatetest123\",\r\n  \"userRole\": \"CANDIDATE\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{api_base_url}}/api/auth/register",
              "host": [
                "{{api_base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          },
          "response": []
        },
